    "SMAC": "BAX_BAK",
    "BAX_BAK": "(P53  or   not BCL2  or   not BCLxL)  and   not MCL1",
    "CytoC": "BAX_BAK",
    "Caspase9": "CytoC  and   not XIAP",
    "Caspase8": "TNF_stim  and   not cFLIP",
    "cFLIP": "NFkB",
    "Caspase3": "(Caspase9  or  Caspase8)  and   not XIAP",
    "Apoptosis": "Caspase3",
    "CDK4": "CyclinD",
    "CyclinD": "ERK  or  AKT  or  MYC",
    "MYC": "ERK  or  AKT  or  STAT3",
    "RB1": " not CDK4",
