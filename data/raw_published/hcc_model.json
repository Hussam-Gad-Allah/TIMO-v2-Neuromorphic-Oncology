    "VEGFR": "VEGF_stim",
    "MET": "HGF_stim",
    "FGFR": "FGF_stim",

    "RAS": "VEGFR  or  MET  or  FGFR",
    "BRAF": "RAS",
    "MEK": "BRAF",
    "ERK": "MEK",

    "PI3K": "PIK3CA_mut  or  VEGFR  or  MET  or  RAS",
    "PTEN": "not PTEN_loss  and  P53",
    "AKT": "PI3K  and  not PTEN",
    "mTOR": "AKT",

    "GSK3B": "not AKT  and  not AXIN1_loss",
    "WNT_beta_catenin": "CTNNB1_mut  or  WNT_stim  or  not GSK3B",

    "STAT3": "MET  or  ERK",
    "NFkB": "AKT  or  Chemo_DNA_damage",

    "ATM_ATR": "Chemo_DNA_damage",
    "MDM2": "AKT  and  not ATM_ATR",
    "P53": "ATM_ATR  and  not MDM2  and  not P53_mut",

    "BCL2": "(NFkB  or  STAT3  or  WNT_beta_catenin)  and  not BAX",
    "BCLxL": "(NFkB  or  STAT3  or  ERK)  and  not BAX",
    "MCL1": "(AKT  or  ERK  or  STAT3)  and  not BAX",
    "XIAP": "(AKT  or  NFkB)  and  not SMAC",

    "BAX": "(P53  or  not BCL2  or  not BCLxL)  and  not MCL1",
    "CytoC": "BAX",
    "SMAC": "BAX",

    "Caspase9": "CytoC  and  not XIAP",
    "Caspase8": "Chemo_DNA_damage",
    "Caspase3": "(Caspase9  or  Caspase8)  and  not XIAP",
    "Apoptosis": "Caspase3",

    "Proliferation": "(ERK  or  AKT  or  WNT_beta_catenin  or  TERT_prom_mut)  and  not Apoptosis"
  }
}
