    "PIK3CA_mut": "PIK3CA_mut",
    "PTEN_loss": "PTEN_loss",
    "AKT2_amp": "AKT2_amp",
    "EGFR": "EGF_stim",
    "VEGFR": "VEGF_stim",
    "PI3K": "EGFR  or  PIK3CA_mut",
    "PTEN": "not PTEN_loss  and  P53",
    "AKT": "(PI3K  or  AKT2_amp)  and  not PTEN",
    "mTOR": "AKT",
    "RAS_MAPK": "EGFR  or  VEGFR",
    "MEK": "RAS_MAPK",
    "ERK": "MEK",
    "PARP": "Chemo_DNA_damage  and  not Apoptosis",
    "HR_repair": "not BRCA1_mut  and  not BRCA2_mut  and  Chemo_DNA_damage",
    "ATM_ATR": "Chemo_DNA_damage  and  not HR_repair",
    "MDM2": "AKT  and  not ATM_ATR",
    "P53": "ATM_ATR  and  not MDM2  and  not P53_mut",
    "CyclinE1": "CCNE1_amp  or  E2F1  or  MYC",
    "CDK2": "CyclinE1  and  not P21",
    "P21": "P53  and  not AKT",
    "RB1": "not CDK2",
    "E2F1": "not RB1",
    "MYC": "ERK  or  AKT",
    "NFkB": "AKT  or  Chemo_DNA_damage",
    "STAT3": "EGFR  or  VEGFR  or  NFkB",
    "BCL2": "(NFkB  or  STAT3)  and  not BAX",
    "BCLxL": "(NFkB  or  STAT3  or  ERK)  and  not BAX",
    "MCL1": "(AKT  or  ERK  or  STAT3)  and  not BAX",
    "XIAP": "(AKT  or  NFkB)  and  not SMAC",
    "BAX": "(P53  or  not BCL2  or  not BCLxL)  and  not MCL1",
    "CytoC": "BAX",
    "SMAC": "BAX",
    "Caspase9": "CytoC  and  not XIAP",
    "Caspase8": "FASL_stim  and  not cFLIP",
    "cFLIP": "NFkB",
    "Caspase3": "(Caspase9  or  Caspase8)  and  not XIAP",
    "Apoptosis": "Caspase3",
    "Proliferation": "(E2F1  or  MYC  or  AKT  or  CDK2)  and  not Apoptosis"
  }
}